# docker/Dockerfile

# Debian slim rather than Alpine: every dependency, matplotlib included, has a manylinux wheel
# for both amd64 and arm64, so nothing is compiled on either architecture.
FROM python:3.14-slim
COPY --from=ghcr.io/astral-sh/uv:0.13.6 /uv /usr/local/bin/uv

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*
RUN python -m pip uninstall pip setuptools -y

COPY runentrypoint.sh /usr/bin/entrypoint.sh
RUN chmod 555 /usr/bin/entrypoint.sh

RUN useradd -m -u 1001 owl && chown -R owl /app
USER owl

RUN rm -rf /app/owl
RUN git clone --depth 1 https://github.com/mdlacasse/Owl.git owl

# Install from uv.lock with the assistant extra, skipping the dev group and MOSEK (no license shipped in the image).
# --no-install-package overrides owlplanner's hard dependency on mosek; uv.lock is unchanged,
# so the cloud (uv-sync) still gets MOSEK. App falls back to HiGHS gracefully when mosek is absent.
RUN cd /app/owl && uv sync --frozen --no-dev --extra assistant --no-install-package mosek --no-cache

EXPOSE 8501

# Slim has no wget.
HEALTHCHECK CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8501/_stcore/health')" || exit 1

ENTRYPOINT ["/bin/bash", "/usr/bin/entrypoint.sh"]
