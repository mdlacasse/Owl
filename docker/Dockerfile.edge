# docker/Dockerfile

# Debian slim rather than Alpine: every dependency, matplotlib included, has a manylinux wheel
# for both amd64 and arm64, so the uv sync at start compiles nothing on either architecture.
FROM python:3.14-slim
COPY --from=ghcr.io/astral-sh/uv:0.11.19 /uv /usr/local/bin/uv

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*
RUN python -m pip uninstall pip setuptools -y

COPY buildentrypoint.sh /usr/bin/entrypoint.sh
COPY runentrypoint.sh /usr/bin/runentrypoint.sh
RUN chmod 555 /usr/bin/entrypoint.sh /usr/bin/runentrypoint.sh

RUN useradd -m -u 1001 owl && chown -R owl /app
USER owl

EXPOSE 8501

# Slim has no wget.
HEALTHCHECK CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8501/_stcore/health')" || exit 1

ENTRYPOINT ["/bin/bash", "/usr/bin/entrypoint.sh"]
